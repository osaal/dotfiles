###################
### MY PROGRAMS ###
###################

# TODO: the y function doesn't work here, as it is spawned in a new subshell!
$fileManager = y

#############################
### ENVIRONMENT VARIABLES ###
#############################

xwayland {
    force_zero_scaling = true
}

# Fix issues with flickering cursor,
# see https://discourse.nixos.org/t/hyprland-cursor-disappears-on-some-apps/57458
cursor {
    inactive_timeout = 0
    no_hardware_cursors = true
}
